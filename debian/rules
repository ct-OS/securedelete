#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk
# cxx-qt-build and gui/build.rs locate Qt 6 through these.
export QMAKE = /usr/lib/qt6/bin/qmake6
export LRELEASE = /usr/lib/qt6/bin/lrelease
# Prefer a rustup toolchain over the distribution's (too old) rustc.
export PATH := $(HOME)/.cargo/bin:$(PATH)
export CARGO_TERM_COLOR = never

# Off amd64, rustc asks gcc for -fuse-ld=lld without supplying an lld, and the
# distribution's lld 17 lacks relocations newer Rust needs on loongarch64.
# Point gcc at the rust-lld bundled with the toolchain instead.
ifneq ($(DEB_HOST_ARCH),amd64)
RUST_GCC_LD := $(firstword $(wildcard $(shell $(HOME)/.cargo/bin/rustc --print sysroot 2>/dev/null)/lib/rustlib/*/bin/gcc-ld))
ifneq ($(RUST_GCC_LD),)
export RUSTFLAGS += -Clink-arg=-B$(RUST_GCC_LD) -Clink-arg=-fuse-ld=lld
endif
endif

# GCC 12 writes absolute relocations into .eh_frame on loongarch64, which lld
# rejects in a PIE; clang emits PC-relative ones. (g++-13 is not installable.)
ifeq ($(DEB_HOST_ARCH),loong64)
export CXX = clang++
endif

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo --version
	cargo build --release --locked --workspace

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --locked
endif

override_dh_auto_install:

override_dh_auto_clean:
	rm -rf target

# Rust's DWARF is large and dwz often fails on it.
override_dh_dwz:
